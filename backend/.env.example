# Copy this file to .env in the same folder and fill in real values.
# main.py loads .env automatically (via python-dotenv) on startup.
# Never commit .env — it's already in .gitignore.

# Get yours: https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=""

# Your Azure Log Analytics workspace ID (the GUID, not the workspace name) —
# find it under your workspace's Overview page in the Azure portal.
LOG_ANALYTICS_WORKSPACE_ID=""

# Required for /api/investigate, /api/plan, and /api/isolate — those 500
# until this is set (fails closed rather than letting requests through
# unprotected). /api/history stays open; /api/analyze isn't gated either,
# by design — see the note above that route in main.py.
HUNT_PASSWORD=""
